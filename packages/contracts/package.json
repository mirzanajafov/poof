{
  "name": "@poof/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout": {
      "source": "./src/layout.ts",
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./bench": {
      "source": "./src/bench.ts",
      "types": "./dist/bench.d.ts",
      "default": "./dist/bench.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@poof/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
